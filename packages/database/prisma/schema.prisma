generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum SecurityEventSeverity {
  INFO
  WARNING
  CRITICAL
}

model User {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String        @db.VarChar(320)
  emailNormalized String        @unique @map("email_normalized") @db.VarChar(320)
  passwordHash    String        @map("password_hash")
  name            String
  status          UserStatus    @default(ACTIVE)
  platformRole    PlatformRole? @map("platform_role")
  sessionVersion  Int           @default(1) @map("session_version")
  mfaEnabled      Boolean       @default(false) @map("mfa_enabled")
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)

  memberships         Membership[]
  securityEvents      SecurityEvent[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  @@index([status, deletedAt])
  @@map("users")
}

model Organization {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?          @map("deleted_at") @db.Timestamptz(3)

  memberships    Membership[]
  securityEvents SecurityEvent[]
  auditLogs      AuditLog[]

  @@index([status, deletedAt])
  @@map("organizations")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships     Membership[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Membership {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  roleId          String           @map("role_id") @db.Uuid
  status          MembershipStatus @default(ACTIVE)
  themePreference ThemePreference  @default(SYSTEM) @map("theme_preference")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId, status])
  @@index([roleId])
  @@map("memberships")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("password_reset_tokens")
}

model SecurityEvent {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType       String                @map("event_type")
  severity        SecurityEventSeverity
  ipAddressMasked String?               @map("ip_address_masked")
  ipAddressHash   String?               @map("ip_address_hash")
  userAgent       String?               @map("user_agent")
  userId          String?               @map("user_id") @db.Uuid
  organizationId  String?               @map("organization_id") @db.Uuid
  metadata        Json?                 @db.JsonB
  occurredAt      DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(3)

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizationId, occurredAt])
  @@index([userId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([severity, occurredAt])
  @@map("security_events")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  metadata       Json?    @db.JsonB
  correlationId  String?  @map("correlation_id")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // Explícito SetNull para actorUser
  actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizationId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@map("audit_logs")
}
