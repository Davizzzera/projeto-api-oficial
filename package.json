{
  "name": "whatsapp-saas",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:load": "turbo run test:load",
    "clean": "turbo run clean && rm -rf node_modules",
    "infra:start": "docker compose -f infra/docker/docker-compose.yml --profile core up -d",
    "infra:start:full": "docker compose -f infra/docker/docker-compose.yml --profile full up -d",
    "infra:stop": "docker compose -f infra/docker/docker-compose.yml down",
    "test:db:up": "docker compose -f infra/docker/docker-compose.test.yml up -d",
    "test:db:migrate": "pnpm --filter @repo/database exec prisma migrate deploy",
    "test:db:down": "docker compose -f infra/docker/docker-compose.test.yml down -v",
    "test:integration": "pnpm --filter @repo/api run test:integration",
    "test:integration:local": "pnpm run test:db:up && pnpm run test:db:migrate && pnpm run test:integration && pnpm run test:db:down",
    "db:migrate": "pnpm --filter @repo/database migrate",
    "db:seed": "pnpm --filter @repo/database seed",
    "db:studio": "pnpm --filter @repo/database studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "globals": "^17.7.0",
    "playwright": "^1.61.1",
    "turbo": "^2.0.4",
    "typescript": "^5.5.3"
  },
  "packageManager": "pnpm@9.5.0"
}
