# Application
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
API_PORT=3333
NEXT_PUBLIC_API_URL=http://localhost:3333
INTERNAL_API_URL=http://localhost:3333
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://whatsapp_user:CHANGE_ME_DB_PASSWORD@localhost:5432/whatsapp_saas

# Redis
REDIS_URL=redis://localhost:6379
REDIS_URL_TEST=redis://localhost:6380

# Security & Sessions
SESSION_SECRET=CHANGE_ME_GENERATE_RANDOM_32_BYTES
SESSION_COOKIE_SECRET=CHANGE_ME_GENERATE_RANDOM_32_BYTES_2
CSRF_HMAC_SECRET=CHANGE_ME_GENERATE_RANDOM_32_BYTES_3
SESSION_TTL=604800
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_GENERATE_RANDOM_32_BYTES
PASSWORD_RESET_SECRET=CHANGE_ME_GENERATE_RANDOM_32_BYTES
CSRF_SECRET=CHANGE_ME_GENERATE_RANDOM_32_BYTES

# Storage (MinIO local setup for dev)
STORAGE_PROVIDER=minio
STORAGE_PATH=./storage-local # If provider is local
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
# App restricted user (used by the application)
MINIO_ACCESS_KEY=whatsapp_app
MINIO_SECRET_KEY=CHANGE_ME_MINIO_APP_SECRET
MINIO_BUCKET=whatsapp-media

# WhatsApp Provider
WHATSAPP_PROVIDER_MODE=MOCK
META_GRAPH_API_VERSION=v21.0
META_APP_ID=CHANGE_ME_APP_ID
META_APP_SECRET=CHANGE_ME_APP_SECRET
META_WABA_ID=CHANGE_ME_WABA_ID
META_PHONE_NUMBER_ID=CHANGE_ME_PHONE_ID
META_ACCESS_TOKEN=CHANGE_ME_ACCESS_TOKEN
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_WEBHOOK_TOKEN

# Mock Provider Config
MOCK_ACCEPTANCE_RATE=0.98
MOCK_DELIVERY_RATE=0.95
MOCK_READ_RATE=0.70
MOCK_REPLY_RATE=0.15
MOCK_FAILURE_RATE=0.02
MOCK_MIN_DELAY_MS=500
MOCK_MAX_DELAY_MS=5000

# Observability
LOG_LEVEL=debug
LOG_RETENTION_DAYS=30

# Uploads
UPLOAD_MAX_SIZE=16777216
DEFAULT_TIMEZONE=America/Sao_Paulo
